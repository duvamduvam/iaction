{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IAction",
  "version": "0.1.2",
  "identifier": "net.duvam.iaction",
  "build": {
    "beforeDevCommand": "npm run dev -w ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run preparer-bundle",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "IAction",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/sidecar-bundle/": "sidecar/"
    },
    "externalBin": [
      "binaries/node"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
