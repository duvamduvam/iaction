{
  "name": "iaction",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "workspaces": [
    "ui",
    "sidecar"
  ],
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "ui:build": "npm run build -w ui",
    "sidecar:build": "npm run build -w sidecar",
    "sidecar:test": "npm run test -w sidecar",
    "preparer-bundle": "bash scripts/preparer-bundle.sh",
    "build:linux": "tauri build --bundles appimage",
    "build:windows": "tauri build --bundles nsis",
    "lint": "eslint .",
    "ui:test": "npm run test -w ui",
    "verif": "npm run lint && npm run cliquet:test && npm run cliquet && npm run casse:test && npm run casse && npm run audit:test && npm run audit && npm run tickets:test && npm run version:test && npm run version:verifier && npm run test -w ui && npm run sidecar:test && cargo test --quiet --manifest-path src-tauri/Cargo.toml",
    "cliquet": "node scripts/cliquet-taille.mjs",
    "casse": "node scripts/collisions-casse.mjs",
    "casse:test": "node scripts/collisions-casse.test.mjs",
    "cliquet:maj": "node scripts/cliquet-taille.mjs --maj",
    "cliquet:test": "node scripts/cliquet-taille.test.mjs",
    "audit": "node scripts/audit-publication.mjs",
    "audit:test": "node scripts/audit-publication.test.mjs",
    "tickets:test": "node scripts/refleter-tickets.test.mjs",
    "version:verifier": "node scripts/versionner.mjs",
    "version:test": "node scripts/versionner.test.mjs",
    "version:poser": "node scripts/versionner.mjs",
    "tickets:miroir": "node scripts/refleter-tickets.mjs",
    "publier": "bash scripts/publier-instantane.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1"
  }
}
