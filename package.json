{
  "name": "iaction",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "ui",
    "sidecar"
  ],
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "ui:build": "npm run build -w ui",
    "sidecar:build": "npm run build -w sidecar",
    "sidecar:test": "npm run test -w sidecar",
    "preparer-bundle": "bash scripts/preparer-bundle.sh",
    "build:linux": "tauri build --bundles appimage",
    "build:windows": "tauri build --bundles nsis",
    "lint": "eslint .",
    "ui:test": "npm run test -w ui",
    "verif": "npm run lint && npm run test -w ui && npm run sidecar:test && cargo test --quiet --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1"
  }
}
